APP_ENV=development
LOG_LEVEL=INFO
# auto = JSON on Cloud Run (K_SERVICE set), plain text elsewhere; or text | json
LOG_FORMAT=auto
GRADIO_SHARE=false

# Active providers
# Provider selection is explicit; model names never select a provider.
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=ollama

# Chat model settings
LLM_MODEL=google/gemini-3-flash-preview
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_CONTEXT_TOKENS=10000

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2

# Optional visual grounding
VISION_MODEL=

# Infrastructure
# Use mode=cloud with the HTTPS cluster URL and API key for hosted Weaviate.
WEAVIATE_MODE=local
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_ADMIN_API_KEY=
WEAVIATE_VIEWER_API_KEY=
WEAVIATE_TENANT=
WEAVIATE_VECTOR_DIMENSION=768
FIRECRAWL_API_KEY=
MISTRAL_API_KEY=
YOUTUBE_COOKIES_FILE=
# Secret Manager secret holding the cookies (wins over the file; fetched with gcloud
# into a temporary file for the run and deleted afterwards). Needs GCP_PROJECT.
YOUTUBE_COOKIES_SECRET=
# Google Cloud project for make deploy and Secret Manager. No default: required.
GCP_PROJECT=
# Private bucket for snapshots, registry and run state (make snapshot-backup).
STATE_BUCKET=

# Ingestion
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K=10
